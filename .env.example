# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://khatmsaz:khatmsaz@localhost:5432/khatmsaz

# --- Redis (wizard state, scheduling) ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Telegram bot username without @, used to build invite links (t.me/<username>)
TELEGRAM_BOT_USERNAME=
# Numeric id of the private canonical Quran source channel. The bot must be
# added to this channel before historical posts can be forwarded.
QURAN_SOURCE_TELEGRAM_CHAT_ID=-1001127138974

# Local-dev-only: if you're on a network where Telegram is blocked and you
# normally reach it through a VPN/proxy app, point this at that app's local
# proxy address (e.g. http://127.0.0.1:12334). Leave empty on a real server
# with normal internet access — this should almost never be set in production.
BOT_HTTP_PROXY_URL=

# --- Bale bot (Bale uses a Telegram-compatible Bot API at a different base URL) ---
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_BOT_USERNAME=

# Mobile admin dashboard. Local test example: http://192.168.1.20:8000
# Production after DNS + HTTPS deployment: https://khatmsaz.com
ADMIN_WEB_ENABLED=true
ADMIN_WEB_HOST=0.0.0.0
ADMIN_WEB_PORT=8000
# Public HTTPS Mini App origin, for example https://app.khatmsaz.com
ADMIN_WEB_BASE_URL=
# Set only after DNS and HTTPS are live. Example: https://khatmsaz.com
PUBLIC_WEB_BASE_URL=

# --- OTP / SMS ---
# Secret used to HMAC-hash OTP codes before storing them. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
OTP_HMAC_SECRET=
# When set to 1, OTP codes are printed to the bot logs instead of sent by SMS.
# NEVER set this to 1 in production.
DEV_OTP=0

# --- SMS provider (fill in once you have credentials from your SMS panel) ---
SMS_PROVIDER=noop
SMS_API_KEY=
SMS_SENDER=
SMS_API_BASE_URL=https://api.kavenegar.com/v1

# --- Payment (ZarinPal) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- Payment (PayPing v3) ---
# Store the dedicated API token from the PayPing panel here. Never put the
# panel login password in this file or in source control.
PAYPING_API_TOKEN=
# This exact public HTTPS route must reach the FastAPI process. Local/LAN
# addresses are not accepted for a real bank-return flow.
PAYPING_CALLBACK_URL=https://khatmsaz.com/payments/payping/callback

# --- Admin ---
# Comma-separated numeric Telegram chat ids. Whoever's id is listed here is
# auto-promoted to SUPER_ADMIN the next time they send /start. Get your own
# numeric chat id from a bot like @userinfobot, then message your own bot
# once with that id listed here.
SUPER_ADMIN_TELEGRAM_CHAT_IDS=

# --- App ---
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
# How often the reminder/deadline-miss scan runs, in minutes.
REMINDER_SCAN_INTERVAL_MINUTES=30
# Previous-month positive report. If the app was offline at this exact time,
# the next scan after it catches up once; valid day is 1..28.
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=10
# Cost to create a khatm, in Toman. Keep 0 until the PayPing token and public
# callback have passed one live low-value payment test.
KHATM_CREATION_PRICE_TOMAN=0
